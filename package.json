{
  "name": "novi-sad-bus-map",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Interactive map of Novi Sad public transport (101 bus lines) — JGSP GTFS + OSM + HMM map matching",
  "scripts": {
    "download": "bash pipeline/download.sh",
    "build": "node --max-old-space-size=6144 pipeline/build.mjs --all",
    "lines": "node --max-old-space-size=6144 pipeline/lines.mjs",
    "report": "node pipeline/report-gaps.mjs",
    "audit": "node --max-old-space-size=6144 pipeline/audit.mjs",
    "serve": "node pipeline/serve.mjs 8173"
  }
}
